import sys
import tomllib
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

SCHEMA_VERSION = 1

# The two `.env` fields that hold a credential. They are written blank whatever
# a profile says, and a profile that names one at all is rejected rather than
# quietly ignored: a secret typed into a document that gets mailed around is
# leaked, and silently dropping it would leave the author believing otherwise.
SECRET_ENV_KEYS = ("WORK_TRACKER_API_KEY", "COMMS_CHANNEL_TOKEN")

TECH_LEVELS = ("technical", "non-technical")

report = {"written": [], "unchanged": [], "deferred": [], "outstanding": [], "errors": []}

def written(path, detail):
	report["written"].append({"path": str(path), "detail": detail})

def unchanged(path, detail):
	report["unchanged"].append({"path": str(path), "detail": detail})

def deferred(what, who_decides, pointer):
	report["deferred"].append({"what": what, "who_decides": who_decides, "pointer": pointer})

def outstanding(what, why):
	report["outstanding"].append({"what": what, "why": why})

def error(message):
	report["errors"].append(message)

# --- the .env schema, borrowed rather than restated -------------------------

def load_doctor(repo_root):
	"""`spoor-doctor`, imported as a module, for its `.env.example` parser.

	`.env.example` is the one home for the schema and `spoor-doctor` is the one
	home for reading its `# doctor:` annotations. Writing a second parser here
	would give this script its own opinion of what the schema says, which is
	the drift the whole repo is organized against — so it imports that one. The
	file has no `.py` extension because it is a command; that is the only
	reason this needs a loader rather than a plain import."""
	doctor_path = repo_root / "spoor-doctor"
	if not doctor_path.is_file():
		return None
	spec = spec_from_loader("spoor_doctor", SourceFileLoader("spoor_doctor", str(doctor_path)))
	module = module_from_spec(spec)
	spec.loader.exec_module(module)
	return module

