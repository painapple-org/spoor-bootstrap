# Copy to .env next to this file. Never commit the real .env.
#
# docker-compose.yml reads every one of these. There are no defaults in the
# compose file on purpose: a missing value fails the `docker compose` call
# loudly instead of starting a dashboard that quietly measures the wrong host.

# This deployment's own service-name prefix plus what the thing is. Becomes the
# container name, the mesh node hostname, and the URL the owner types - all
# three, which is the point. Usually the agent's own name, e.g. `myagent-dash`.
DASHBOARD_NAME=

# Shown in the browser tab and as the heading on the overview page.
DASHBOARD_TITLE=Internal dashboard

# The uid/gid that owns the checkouts mounted into the container, and the gid
# of the group that owns the container-runtime socket. On the host:
#   id -u ; id -g ; getent group docker | cut -d: -f3
DASHBOARD_UID=
DASHBOARD_GID=
DASHBOARD_DOCKER_GID=

# Filesystem to report free space on, as seen from inside the container.
# Point this at one of the read-only mounts to measure the host filesystem
# that actually matters rather than the container's own root.
DASHBOARD_DISK_PATH=/

# Colon-separated git checkouts the Shipping page reads. Each one also needs a
# read-only bind mount in docker-compose.yml, at the same path.
DASHBOARD_REPO_PATHS=

# Single-use auth key for the mesh node, provisioned by the owner - never by
# the agent. `skills/private-networking/SKILL.md` is the home for that split
# and for which variables the sidecar image reads.
DASHBOARD_TS_AUTHKEY=
